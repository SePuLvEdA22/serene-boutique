# Store driver: 'lowdb' (persistent JSON file) or 'memory' (resets on restart)
STORE_DRIVER=lowdb

# JWT secret for signing tokens.
# OBLIGATORIO en producción: la app falla al arrancar (build) si no está
# configurado. Mínimo 32 caracteres. Usa un valor aleatorio, p. ej.:
#   openssl rand -base64 48
JWT_SECRET=my-super-secret-key-change-this-in-production-32chars

# Admin credentials.
# OBLIGATORIOS en producción: sin ellos la app falla (no crea un admin con
# credenciales por defecto). ADMIN_PASSWORD debe cumplir la política de
# contraseñas: mínimo 8 caracteres, al menos una mayúscula y un número.
ADMIN_EMAIL=admin@switchandtech.mx
ADMIN_PASSWORD=CambiaEstaClave-2026

# Mercado Pago (optional, for payments)
NEXT_PUBLIC_MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=

# Webhook signature verification (REQUIRED in production)
# Configúralo en el panel de MercadoPago → Webhooks → "Secret".
# Sin él, el webhook acepta notificaciones sin verificar la firma.
MP_WEBHOOK_SECRET=

# Distributed rate limiting via Upstash Redis (optional)
# Si se definen, el rate limiter usa Upstash en lugar de memoria local
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
